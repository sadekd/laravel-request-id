{
    "name": "sadekd/laravel-request-id",
    "description": "Laravel Request ID",
    "keywords": [
        "laravel",
        "request",
        "id"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Daniel Šádek",
            "email": "me@danielsadek.cz"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "autoload": {
        "psr-4": {
            "SadekD\\LaravelRequestId\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SadekD\\LaravelRequestId\\LaravelRequestIdServiceProvider"
            ],
            "aliases": {
                "RequestId": "SadekD\\LaravelRequestId\\Facades\\RequestId"
            }
        }
    }
}
